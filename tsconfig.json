{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "declaration": true,
    "types": [
      "node"
    ]
  },

  "include": [
    "features/**/*.ts",
    "test/**/*.ts"
  ],

  "exclude": [
    "node_modules"
  ]
}
